// Title: Password spray: one IP failing against many accounts
// Data source table: SigninLogs
// What it detects: A single source IP failing to sign in as many different users inside one time bucket,
//   with only a few attempts per user. Spraying tries one or two common passwords per account to stay
//   under per-account lockout thresholds.
// Likely false positives: A corporate proxy or VPN concentrator that fronts many users with a shared IP;
//   a mass password-expiry event; a misconfigured mail client rollout.
// MITRE ATT&CK technique: T1110.003 Brute Force: Password Spraying
// Tuning notes: Lower minUsers for small tenants. maxAttemptsPerUser separates spraying (few tries per
//   user) from brute force (many tries per user, see 01). ResultType 50126 is a wrong password and 50034
//   means the user does not exist, which sprayers hit when they guess usernames. Pair with query 04 to
//   see whether any of the targeted accounts later signed in successfully from the same IP.
// Status: Written against the documented SigninLogs schema. Not yet run in a live Sentinel workspace.

let lookback = 1d;
let binSize = 15m;
let minUsers = 10;
let maxAttemptsPerUser = 3.0;
let failureCodes = dynamic(["50126", "50034"]);
SigninLogs
| where TimeGenerated > ago(lookback)
| where ResultType in (failureCodes)
| summarize
    UsersTargeted = dcount(UserPrincipalName),
    FailedAttempts = count(),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated),
    SampleUsers = make_set(UserPrincipalName, 10),
    Apps = make_set(AppDisplayName, 5)
    by IPAddress, TimeBucket = bin(TimeGenerated, binSize)
| where UsersTargeted >= minUsers
| extend AttemptsPerUser = round(todouble(FailedAttempts) / UsersTargeted, 2)
| where AttemptsPerUser <= maxAttemptsPerUser
| project TimeBucket, IPAddress, UsersTargeted, FailedAttempts, AttemptsPerUser, FirstSeen, LastSeen, SampleUsers, Apps
| order by UsersTargeted desc
